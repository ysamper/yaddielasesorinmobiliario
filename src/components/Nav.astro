---
---
<nav class="site-nav">
  <a href="/" class="nav-brand">Yaddiel <span>Samper</span></a>
  <button class="nav-toggle" aria-label="Abrir menu" aria-expanded="false">
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
    <span class="nav-toggle-bar"></span>
  </button>
  <div class="nav-backdrop" id="nav-backdrop"></div>
  <div class="nav-actions">
    <a href="/#inversores" class="nav-link">Inversores</a>
    <a href="/#como-funciona" class="nav-link">Vendedores</a>
    <a href="/blog" class="nav-link">Blog</a>
    <a href="/recursos" class="nav-link">Recursos gratis</a>
    <a href="/#valoracion" class="nav-cta">Valoracion gratuita</a>
  </div>
</nav>
<script>
  const toggle = document.querySelector('.nav-toggle');
  const actions = document.querySelector('.nav-actions');
  const backdrop = document.getElementById('nav-backdrop');

  function openMenu() {
    actions?.classList.add('nav-open');
    toggle?.classList.add('nav-toggle--open');
    toggle?.setAttribute('aria-expanded', 'true');
    backdrop?.classList.add('nav-backdrop--visible');
    document.body.classList.add('menu-open');
  }

  function closeMenu() {
    actions?.classList.remove('nav-open');
    toggle?.classList.remove('nav-toggle--open');
    toggle?.setAttribute('aria-expanded', 'false');
    backdrop?.classList.remove('nav-backdrop--visible');
    document.body.classList.remove('menu-open');
  }

  if (toggle && actions) {
    toggle.addEventListener('click', () => {
      const isOpen = actions.classList.contains('nav-open');
      if (isOpen) closeMenu();
      else openMenu();
    });

    backdrop?.addEventListener('click', closeMenu);

    actions.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', closeMenu);
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && actions.classList.contains('nav-open')) {
        closeMenu();
        toggle.focus();
      }
    });
  }
</script>
