            "Fondos de inversion inmobiliaria"
          ]
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://yaddielasesorinmobiliario.com/#negocio",
          "name": "Yaddiel Samper Asesor Inmobiliario",
          "image": "https://yaddielasesorinmobiliario.com/yaddiel-samper.jpg",
          "url": "https://yaddielasesorinmobiliario.com",
          "telephone": "+34679891027",
