---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import CookieConsent from '../components/CookieConsent.astro';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  canonical?: string;
  publishedAt?: Date;
  updatedAt?: Date;
}

const props = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="sVGcjKR209POdwsCFqr3EEOe49nZFLyMM20LiFfDw2o" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Blog Yaddiel Samper" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <SEO {...props} />

    <!-- Google Consent Mode v2 - default denied (RGPD/LSSI-CE) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500
      });
      gtag('js', new Date());
      gtag('config', 'G-ZC00RYF9RQ', {
        anonymize_ip: true,
        cookie_flags: 'SameSite=None;Secure'
      });
    </script>
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-ZC00RYF9RQ"></script>
    <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Person",
          "@id": "https://yaddielasesorinmobiliario.com/#yaddiel",
          "name": "Yaddiel Samper Leal",
          "jobTitle": "Asesor Inmobiliario Especialista en NPL",
          "description": "Asesor inmobiliario especializado en inversión y activos NPL en Tenerife. 2x Premio al Mejor Asesor en Transacciones Institucionales en Canarias.",
          "url": "https://yaddielasesorinmobiliario.com",
          "image": "https://yaddielasesorinmobiliario.com/yaddiel-samper.jpg",
          "telephone": "+34679891027",
          "email": "yaddiel.samper@century21.es",
          "sameAs": [
            "https://www.linkedin.com/in/yaddiel-samper-asesor-inmobiliario",
            "https://www.instagram.com/yaddiel_asesor_inmobiliario/"
          ],
          "worksFor": {
            "@type": "Organization",
            "name": "Century 21 Lighthouse"
          },
          "areaServed": {
            "@type": "State",
            "name": "Canarias"
          },
          "knowsAbout": [
            "NPL Non-Performing Loans",
            "Activos bancarios",
            "Inversion inmobiliaria Tenerife",
            "Transacciones institucionales",
            "Fondos de inversion inmobiliaria"
          ]
        },
        {
          "@type": "LocalBusiness",
          "@id": "https://yaddielasesorinmobiliario.com/#negocio",
          "name": "Yaddiel Samper Asesor Inmobiliario",
          "image": "https://yaddielasesorinmobiliario.com/yaddiel-samper.jpg",
          "url": "https://yaddielasesorinmobiliario.com",
          "telephone": "+34679891027",
          "email": "yaddiel.samper@century21.es",
          "address": {
            "@type": "PostalAddress",
            "streetAddress": "Av. El Paso 24, Los Majuelos",
            "addressLocality": "La Laguna",
            "addressRegion": "Santa Cruz de Tenerife",
            "postalCode": "38108",
            "addressCountry": "ES"
          },
          "geo": {
            "@type": "GeoCoordinates",
            "latitude": 28.459296,
            "longitude": -16.303849
          },
          "openingHoursSpecification": {
            "@type": "OpeningHoursSpecification",
            "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday"],
            "opens": "09:00",
            "closes": "19:00"
          },
          "areaServed": {
            "@type": "State",
            "name": "Canarias"
          }
        }
      ]
    }
    </script>
  </head>
  <body>
    <Nav />
    <main>
      <slot />
    </main>
    <Footer />
    <CookieConsent />
    <script>
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry, i) => {
          if (entry.isIntersecting) {
            setTimeout(() => entry.target.classList.add('visible'), i * 80);
          }
        });
      }, { threshold: 0.1 });
      document.querySelectorAll('.fade-in').forEach(el => observer.observe(el));
    </script>
  </body>
</html>
