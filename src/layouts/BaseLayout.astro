    <meta name="google-site-verification" content="sVGcjKR209POdwsCFqr3EEOe49nZFLyMM20LiFfDw2o" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title="Blog Yaddiel Samper" href="/rss.xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <SEO {...props} />

    <!-- Google Consent Mode v2 - default denied (RGPD/LSSI-CE) -->
