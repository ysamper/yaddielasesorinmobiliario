            "https://www.instagram.com/yaddiel_asesor_inmobiliario/"
          ],
          "worksFor": {
            "@type": "Organization",
            "name": "Century 21 Lighthouse"
          },
          "areaServed": {
            "@type": "State",
            "name": "Canarias"
          },
          "knowsAbout": [
            "NPL Non-Performing Loans",
            "Activos bancarios",
