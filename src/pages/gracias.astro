---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Descarga tu recurso | Yaddiel Samper"
  description="Gracias. Tu recurso está listo para descargar.">

  <section style="padding: 5rem 0; min-height: 60vh; display: flex; align-items: center;">
    <div class="section-inner" style="text-align: center; max-width: 560px; margin: 0 auto;">
      <div style="width: 64px; height: 64px; background: var(--gold-pale); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.5rem; font-size: 1.8rem; color: var(--gold);">✓</div>
      <h1 style="font-family: 'Fraunces', serif; font-size: 2rem; font-weight: 500; margin-bottom: 1rem; color: var(--ink);">Tu recurso está listo.</h1>
      <p style="font-size: 1rem; color: var(--text-body); line-height: 1.6; margin-bottom: 2rem;">La descarga debería empezar automáticamente. Si no es así, usa el botón de abajo.</p>
      <div id="download-area" style="margin-bottom: 2rem;">
        <a id="download-btn" href="#" style="display: inline-block; padding: 14px 28px; background: var(--gold); color: var(--cream); border-radius: 8px; font-size: 1rem; font-weight: 500; text-decoration: none;">Descargar ahora</a>
      </div>
      <div style="margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--border-fine);">
        <p style="font-size: 0.9rem; color: var(--text-body); margin-bottom: 1rem;">Mientras tienes el documento, estos artículos pueden ayudarte:</p>
        <div style="display: flex; flex-direction: column; gap: 8px; text-align: left;">
          <a href="/blog/como-comprar-npl-tenerife-guia-completa" style="font-size: 0.9rem; color: var(--gold); text-decoration: none;">→ Cómo comprar un NPL en Tenerife: guía completa</a>
          <a href="/blog/error-mas-caro-inversor-negociar-fondo" style="font-size: 0.9rem; color: var(--gold); text-decoration: none;">→ El error más caro antes de negociar con un fondo</a>
          <a href="/blog/invertir-inmobiliaria-tenerife-2026" style="font-size: 0.9rem; color: var(--gold); text-decoration: none;">→ Invertir en inmobiliaria en Tenerife en 2026</a>
        </div>
      </div>
    </div>
  </section>

  <script is:inline define:vars={{ checklistB64: "", guiaB64: "" }}>
    const params = new URLSearchParams(window.location.search);
    const recurso = params.get('recurso');
    const btn = document.getElementById('download-btn');

    const b64Data = recurso === 'guia' ? guiaB64 : checklistB64;
    const filename = recurso === 'guia'
      ? '5-errores-inversores-fondos-espana.pdf'
      : 'checklist-due-diligence-npl-canarias.pdf';

    const byteChars = atob(b64Data);
    const byteNums = new Array(byteChars.length);
    for (let i = 0; i < byteChars.length; i++) {
      byteNums[i] = byteChars.charCodeAt(i);
    }
    const byteArray = new Uint8Array(byteNums);
    const blob = new Blob([byteArray], { type: 'application/pdf' });
    const url = URL.createObjectURL(blob);

    btn.href = url;
    btn.setAttribute('download', filename);

    setTimeout(() => {
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
    }, 800);
  </script>

</BaseLayout>
