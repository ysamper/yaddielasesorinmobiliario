---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3);
---
<BaseLayout
  title="Yaddiel Samper | Asesor Inmobiliario y Especialista en NPL en Tenerife"
  description="Especialista en inversión inmobiliaria y activos NPL en Tenerife. 2x Premio al Mejor Asesor en Transacciones Institucionales en Canarias. También capto propiedades en exclusiva.">

  <!-- ===== HERO — Editorial cinematic split with CSS parallax ===== -->
  <section class="hero" id="inicio">
    <div class="hero-parallax-wrap">
      <div class="hero-grid">
        <div class="hero-content">
          <div class="hero-eyebrow">
            <span class="hero-eyebrow-line"></span>
            <span class="hero-eyebrow-text">Asesor inmobiliario en Tenerife</span>
          </div>
          <h1 class="hero-headline">
            <span class="hero-line hero-line--light">El mercado inmobiliario</span>
            <span class="hero-line hero-line--bold">de Tenerife, <em>desde dentro.</em></span>
          </h1>
          <p class="hero-sub">Si eres inversor, te guío en activos NPL y operaciones con fondos. Si quieres vender, trabajo en exclusiva con propietarios que buscan resultados reales.</p>
          <div class="hero-actions">
            <a href="#inversores" class="btn-primary">Soy inversor</a>
            <a href="#valoracion" class="btn-ghost">Quiero vender <span class="btn-arrow">&rarr;</span></a>
          </div>
        </div>
        <div class="hero-photo-col">
          <div class="hero-photo-wrap">
            <picture>
              <source srcset="/yaddiel-samper.webp" type="image/webp" />
              <img src="/yaddiel-samper.jpg" alt="Yaddiel Samper - Asesor Inmobiliario especializado en NPL y activos bancarios en Tenerife" class="hero-img" width="380" height="480" loading="eager" fetchpriority="high" />
            </picture>
            <div class="hero-photo-frame"></div>
          </div>
          <div class="hero-badge">
            <span class="hero-badge-num">2x</span>
            <span class="hero-badge-text">Premio Mejor Asesor<br>Transacciones Institucionales</span>
          </div>
        </div>
      </div>
    </div>
    <div class="hero-scroll-cue" aria-hidden="true">
      <span class="scroll-cue-line"></span>
    </div>
  </section>

  <!-- ===== STATS — Frosted glass overlay with counter animation ===== -->
  <div class="stats" id="stats">
    <div class="stats-inner reveal">
      <div class="stat">
        <div class="stat-num" data-count="2" data-suffix="x">0x</div>
        <div class="stat-label">Premio al Mejor Asesor en<br>Transacciones Institucionales</div>
      </div>
      <div class="stat-rule"></div>
      <div class="stat">
        <div class="stat-num" data-count="3" data-prefix="+" data-suffix="">0</div>
        <div class="stat-label">Años mediando operaciones<br>con fondos de inversión</div>
      </div>
      <div class="stat-rule"></div>
      <div class="stat">
        <div class="stat-num" data-typewriter="N.1">N.1</div>
        <div class="stat-label">Volumen de transacciones<br>institucionales en Canarias</div>
      </div>
    </div>
  </div>

  <!-- ===== MARQUEE — Scrolling text strip ===== -->
  <div class="marquee-strip" aria-hidden="true">
    <div class="marquee-track">
      <div class="marquee-content">
        <span class="marquee-item">NPL</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Fondos Institucionales</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Tenerife</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Exclusiva</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Activos Bancarios</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Canarias</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Due Diligence</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Inversión Inmobiliaria</span>
        <span class="marquee-dot"></span>
      </div>
      <div class="marquee-content">
        <span class="marquee-item">NPL</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Fondos Institucionales</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Tenerife</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Exclusiva</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Activos Bancarios</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Canarias</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Due Diligence</span>
        <span class="marquee-dot"></span>
        <span class="marquee-item">Inversión Inmobiliaria</span>
        <span class="marquee-dot"></span>
      </div>
    </div>
  </div>

  <!-- ===== INVESTORS — Sticky heading + single-column cards ===== -->
  <section id="inversores" class="sect-investors">
    <div class="section-inner sect-investors-layout">
      <div class="inv-sticky-col">
        <div class="section-tag reveal">Para inversores</div>
        <h2 class="section-title section-title--xl reveal">Activos NPL<br>y operaciones<br><em>con fondos<br>en Tenerife.</em></h2>
        <p class="section-intro reveal">Tenerife combina fiscalidad diferencial, rentabilidad sostenida y demanda estructural que pocas zonas de España pueden igualar.</p>
        <div class="inv-sticky-cta reveal">
          <a href="https://calendly.com/ysl-yaddielsamper/consulta-gratuita-de-30min" target="_blank" rel="noopener" class="btn-primary">Quiero analizar una operación</a>
        </div>
      </div>
      <div class="inv-scroll-col">
        <div class="inv-card reveal" style="--reveal-delay: 0ms;">
          <div class="inv-card-watermark">01</div>
          <div class="inv-card-body">
            <div class="inv-card-title">Acceso a activos NPL</div>
            <div class="inv-card-desc">Tengo acceso directo a carteras de fondos de inversión. Activos que no aparecen en ningún portal y que solo llegan por red y confianza.</div>
          </div>
          <div class="inv-card-accent"></div>
        </div>
        <div class="inv-card reveal" style="--reveal-delay: 100ms;">
          <div class="inv-card-watermark">02</div>
          <div class="inv-card-body">
            <div class="inv-card-title">Proceso completo gestionado</div>
            <div class="inv-card-desc">Due diligence, negociación con el fondo, cesión de crédito y resolución final. Te acompaño en cada fase sin que te pierdas en el proceso.</div>
          </div>
          <div class="inv-card-accent"></div>
        </div>
        <div class="inv-card reveal" style="--reveal-delay: 200ms;">
          <div class="inv-card-watermark">03</div>
          <div class="inv-card-body">
            <div class="inv-card-title">Tenerife como mercado</div>
            <div class="inv-card-desc">IGIC al 7%, rentabilidad bruta media del 5,8% y el 23,12% de los compradores extranjeros en España eligen Canarias. Los datos respaldan la decisión.</div>
          </div>
          <div class="inv-card-accent"></div>
        </div>
        <div class="inv-card reveal" style="--reveal-delay: 300ms;">
          <div class="inv-card-watermark">04</div>
          <div class="inv-card-body">
            <div class="inv-card-title">Sin rodeos</div>
            <div class="inv-card-desc">Solo hablo con inversores con capacidad real. Si la operación no tiene sentido para ti, te lo digo antes de perder tu tiempo.</div>
          </div>
          <div class="inv-card-accent"></div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== SELLERS — Vertical timeline with progressive fill ===== -->
  <section id="como-funciona" class="sect-sellers">
    <div class="sect-sellers-bg-num" aria-hidden="true">03</div>
    <div class="section-inner">
      <div class="section-tag reveal">Para vendedores</div>
      <h2 class="section-title reveal">Vende con estrategia.<br><em>No con prisa.</em></h2>
      <div class="timeline" data-timeline>
        <div class="timeline-track">
          <div class="timeline-track-fill"></div>
        </div>
        <div class="timeline-step reveal" style="--reveal-delay: 0ms;">
          <div class="timeline-marker">
            <span class="timeline-num">01</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-title">Solicitas tu valoración</div>
            <div class="timeline-desc">Cuéntame lo básico sobre tu propiedad. Tarda menos de 2 minutos. Sin compromiso.</div>
          </div>
        </div>
        <div class="timeline-step reveal" style="--reveal-delay: 150ms;">
          <div class="timeline-marker">
            <span class="timeline-num">02</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-title">Recibes tu informe en 24h</div>
            <div class="timeline-desc">Precio real de mercado, tiempo estimado de venta y estrategia recomendada. Sin adornos.</div>
          </div>
        </div>
        <div class="timeline-step reveal" style="--reveal-delay: 300ms;">
          <div class="timeline-marker">
            <span class="timeline-num">03</span>
          </div>
          <div class="timeline-body">
            <div class="timeline-title">Trabajamos en exclusiva</div>
            <div class="timeline-desc">Si tiene sentido trabajar juntos, firmo un compromiso real contigo. Un asesor, una estrategia, un resultado.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== DIFFERENTIATORS — Dark section with oversized watermark numerals ===== -->
  <section id="por-que" class="sect-diff">
    <div class="section-inner">
      <div class="diff-header">
        <div class="section-tag reveal">La diferencia</div>
        <h2 class="section-title section-title--xl reveal">Por qué no soy<br><em>un asesor más.</em></h2>
      </div>
      <div class="diff-list">
        <div class="diff-item reveal" style="--reveal-delay: 0ms;">
          <div class="diff-numeral-wrap">
            <span class="diff-numeral-bg" aria-hidden="true">I</span>
            <span class="diff-numeral">I</span>
          </div>
          <div class="diff-body">
            <div class="diff-title">Dos premios que lo demuestran</div>
            <div class="diff-desc">2x Premio al Mejor Asesor en Transacciones Institucionales en Canarias. No es un título honorífico. Es el resultado de cerrar operaciones reales con fondos de inversión internacionales.</div>
          </div>
        </div>
        <div class="diff-item reveal" style="--reveal-delay: 100ms;">
          <div class="diff-numeral-wrap">
            <span class="diff-numeral-bg" aria-hidden="true">II</span>
            <span class="diff-numeral">II</span>
          </div>
          <div class="diff-body">
            <div class="diff-title">Mediación con fondos</div>
            <div class="diff-desc">He mediado operaciones de hasta 850.000 euros entre inversores privados y fondos internacionales. Conozco cómo piensan, cómo negocian y qué necesitan para cerrar.</div>
          </div>
        </div>
        <div class="diff-item reveal" style="--reveal-delay: 200ms;">
          <div class="diff-numeral-wrap">
            <span class="diff-numeral-bg" aria-hidden="true">III</span>
            <span class="diff-numeral">III</span>
          </div>
          <div class="diff-body">
            <div class="diff-title">Especialista en NPL</div>
            <div class="diff-desc">La compra de activos NPL tiene un proceso específico que la mayoría de asesores desconoce. Yo lo conozco desde dentro porque es lo que hago cada día.</div>
          </div>
        </div>
        <div class="diff-item reveal" style="--reveal-delay: 300ms;">
          <div class="diff-numeral-wrap">
            <span class="diff-numeral-bg" aria-hidden="true">IV</span>
            <span class="diff-numeral">IV</span>
          </div>
          <div class="diff-body">
            <div class="diff-title">Exclusiva con compromiso real</div>
            <div class="diff-desc">Cuando capto una propiedad en exclusiva, me comprometo por escrito. Una estrategia, un precio, un asesor que responde. No tres agencias compitiendo a la baja.</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== BLOG — Magazine-style grid ===== -->
  <section id="blog" class="sect-blog">
    <div class="section-inner">
      <div class="section-tag reveal">Mercado inmobiliario</div>
      <h2 class="section-title reveal">Artículos y<br><em>análisis de mercado.</em></h2>
      <div class="blog-grid">
        {posts.map((post, i) => (
          <a href={`/blog/${post.slug}`} class={`blog-card ${i === 0 ? 'blog-card--feat' : ''} reveal`} style={`--reveal-delay: ${i * 120}ms;`}>
            <span class="blog-card-tag">{post.data.pillar ?? 'Artículo'}</span>
            <div class="blog-card-title">{post.data.title}</div>
            <div class="blog-card-excerpt">{post.data.description}</div>
            <div class="blog-card-footer">
              <span class="blog-card-date">{post.data.pubDate.toLocaleDateString('es-ES', { month: 'long', year: 'numeric' })}</span>
              <span class="blog-card-arrow">&rarr;</span>
            </div>
          </a>
        ))}
      </div>
      <div class="section-cta reveal">
        <a href="/blog" class="btn-outline">Ver todos los artículos</a>
      </div>
    </div>
  </section>

  <!-- ===== NEWSLETTER — Dark contrast band ===== -->
  <section class="newsletter-section" id="newsletter">
    <div class="section-inner">
      <div class="newsletter-box reveal">
        <div class="newsletter-left">
          <h2>Análisis de mercado<br><em>cada semana.</em></h2>
          <p>Datos reales sobre inversión inmobiliaria en Canarias. Sin relleno. Para inversores y propietarios que quieren tomar decisiones con información de calidad.</p>
        </div>
        <div class="newsletter-right">
          <script async src="https://subscribe-forms.beehiiv.com/v3/loader.js" data-beehiiv-form="f412d34f-38e2-4cee-bb3e-bebeaf31b2d0"></script>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== CONTACT / MAP ===== -->
  <section class="map-section" id="contacto">
    <div class="section-inner">
      <div class="section-tag reveal">Dónde encontrarme</div>
      <div class="map-grid">
        <div class="map-info reveal">
          <h3>Visítame en<br><em>la oficina.</em></h3>
          <div class="map-detail">
            <div class="map-detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg></div>
            <div class="map-detail-text">
              <strong>Dirección</strong>
              <span>Av. El Paso 24, Los Majuelos<br>38108 La Laguna, Santa Cruz de Tenerife</span>
            </div>
          </div>
          <div class="map-detail">
            <div class="map-detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92Z"/></svg></div>
            <div class="map-detail-text">
              <strong>Teléfono</strong>
              <span>+34 679 89 10 27</span>
            </div>
          </div>
          <div class="map-detail">
            <div class="map-detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg></div>
            <div class="map-detail-text">
              <strong>Email</strong>
              <span>yaddiel.samper@century21.es</span>
            </div>
          </div>
          <div class="map-detail">
            <div class="map-detail-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg></div>
            <div class="map-detail-text">
              <strong>Horario</strong>
              <span>Lunes a Viernes · 9:00 - 19:00</span>
            </div>
          </div>
        </div>
        <div class="map-embed reveal">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3690.363454584872!2d-16.303849124304964!3d28.45929647575984!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0xc41cd02f10f23a1%3A0xd32d828d32548cca!2sAv.%20el%20Paso%2C%2024%2C%2038108%20La%20Laguna%2C%20Santa%20Cruz%20de%20Tenerife!5e1!3m2!1ses!2ses!4v1778943161429!5m2!1ses!2ses"
            width="600"
            height="340"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade">
          </iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- ===== REVIEWS — Horizontal scroll snap testimonials ===== -->
  <section id="resenas" class="sect-reviews">
    <div class="section-inner">
      <div class="section-tag reveal">Lo que dicen los clientes</div>
      <h2 class="section-title reveal">Resultados que<br><em>hablan por sí solos.</em></h2>
    </div>
    <div class="reviews-scroll" aria-label="Reseñas de clientes">
      <div class="reviews-track">
        <div class="review-card reveal" style="--reveal-delay: 0ms;">
          <div class="review-quote-mark" aria-hidden="true">&ldquo;</div>
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="review-text">"Muy profesional, me proporcionó todas las herramientas necesarias para comprar mi casa con toda seguridad!!"</p>
          <div class="review-author">
            <div class="review-avatar">SR</div>
            <div class="review-author-info">
              <strong>Saray Ramos</strong>
              <span>Compradora · enero 2025</span>
            </div>
          </div>
        </div>
        <div class="review-card reveal" style="--reveal-delay: 120ms;">
          <div class="review-quote-mark" aria-hidden="true">&ldquo;</div>
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="review-text">"Yaddiel es un excelente profesional. Me guió en todo el proceso de compra y siempre estuvo atento a todas mis inquietudes. Sin duda, totalmente recomendable."</p>
          <div class="review-author">
            <div class="review-avatar">NG</div>
            <div class="review-author-info">
              <strong>Nido Gomera</strong>
              <span>Comprador · febrero 2025</span>
            </div>
          </div>
        </div>
        <div class="review-card reveal" style="--reveal-delay: 240ms;">
          <div class="review-quote-mark" aria-hidden="true">&ldquo;</div>
          <div class="review-stars">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <p class="review-text">"Una atención excelente. Profesionalismo, compromiso y dedicación. Su alto conocimiento del mercado fue clave para tomar decisiones acertadas. Totalmente recomendable."</p>
          <div class="review-author">
            <div class="review-avatar">JP</div>
            <div class="review-author-info">
              <strong>Jose Edgar Padron</strong>
              <span>Cliente · 2024</span>
            </div>
          </div>
        </div>
      </div>
    </div>
    <div class="section-inner">
      <div class="reviews-cta reveal">
        <a href="https://share.google/79IdYMV3JquUvFMYU" target="_blank" rel="noopener">Ver todas las reseñas en Google &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ===== VALUATION CTA ===== -->
  <section class="cta-section" id="valoracion">
    <div class="section-inner">
      <div class="cta-box reveal">
        <h2>Solicita tu<br><em>valoración gratuita</em></h2>
        <p>Recibes un informe personalizado con el precio real de mercado de tu propiedad en menos de 24 horas. Sin compromiso. Sin presión.</p>
        <div class="rgpd-wrap">
          <input type="checkbox" id="rgpd-consent" />
          <label for="rgpd-consent">Acepto recibir comunicaciones comerciales de Yaddiel Samper relacionadas con mi propiedad y el proceso de venta. Puedo revocar este consentimiento en cualquier momento. <a href="/privacidad">Política de privacidad</a>.</label>
        </div>
        <a href="https://valuation.lystos.com?clientId=2f57af09-10e9-47ce-a505-281fa60511e3" class="btn-primary btn-primary-disabled" id="lystos-btn" target="_blank" rel="noopener" aria-disabled="true">Quiero mi valoración gratuita</a>
        <p class="cta-hint" id="rgpd-hint">Marca la casilla para continuar</p>
        <p class="cta-disclaimer">Datos protegidos bajo el RGPD. Nunca compartidos con terceros.</p>
      </div>
    </div>
  </section>

  <script>
    const cb = document.getElementById('rgpd-consent');
    const btn = document.getElementById('lystos-btn');
    const hint = document.getElementById('rgpd-hint');
    cb?.addEventListener('change', () => {
      const checked = (cb as HTMLInputElement).checked;
      if (checked) {
        btn?.classList.remove('btn-primary-disabled');
        btn?.setAttribute('aria-disabled', 'false');
        hint?.classList.add('cta-hint--hidden');
      } else {
        btn?.classList.add('btn-primary-disabled');
        btn?.setAttribute('aria-disabled', 'true');
        hint?.classList.remove('cta-hint--hidden');
      }
    });
    // Bloquea la navegación por teclado (Tab + Enter/Espacio) cuando el
    // consentimiento RGPD no está marcado. pointer-events:none solo bloquea
    // el ratón, no la activación por teclado en un <a href>.
    btn?.addEventListener('click', (e) => {
      if (btn.getAttribute('aria-disabled') === 'true') {
        e.preventDefault();
        cb?.focus();
        hint?.classList.remove('cta-hint--hidden');
      }
    });
  </script>
</BaseLayout>
